# Configuration locale sans secret. Ne pas activer la démo avec des données réelles.
PORT=3001
HOST=0.0.0.0
DATA_DIR=./data
SEED_DEMO=false

# Production : définir NODE_ENV=production, un secret aléatoire d'au moins
# 32 caractères et COOKIE_SECURE=true derrière HTTPS. Ne pas réutiliser
# un secret entre installations. Aucun secret réel ne doit être versionné.
# NODE_ENV=production
# SESSION_SECRET=
# COOKIE_SECURE=true
# APP_ORIGIN=https://votre-domaine-public

# IA facultative : choisir un fournisseur. Valeurs secrètes uniquement dans
# les paramètres sécurisés ou .env local ignoré. Anthropic a priorité si les
# deux clés sont présentes. Vérifier autorisations, modèle et traitement des
# données avant utilisation réelle.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# AI_API_KEY=
# AI_MODEL=gpt-4.1-mini
# AI_BASE_URL=https://api.openai.com/v1
# AI_BASE_URL est limité à cette API officielle, pas à un proxy arbitraire.
# Plafond de demandes IA par établissement et par heure (20 à 10 000).
AI_SCHOOL_HOURLY_LIMIT=200

# Connecteur communautaire expérimental École Directe : désactivé par défaut.
# L'activer seulement après autorisations et tests décrits dans docs/ECOLEDIRECTE.md.
ENABLE_ECOLEDIRECTE=false
# Version du protocole observé ; changer seulement après vérification de compatibilité.
ECOLEDIRECTE_API_VERSION=4.97.2
# ECOLEDIRECTE_ENCRYPTION_KEY=
# Clé aléatoire de 32 octets encodée en base64, à fournir via le gestionnaire
# sécurisé Railway. Jamais dans Git ou une conversation. Sauvegarde séparée
# de la base nécessaire pour déchiffrer les connexions restaurées.
