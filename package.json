{
  "name": "iabne",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --use-env-proxy --watch server/index.mjs\" \"vite --host 0.0.0.0\"",
    "start": "node --use-env-proxy server/index.mjs",
    "build": "vite build",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "provision": "node scripts/provision.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "demo": "node scripts/demo.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "format": "prettier --write src server scripts tests vite.config.js package.json railway.json index.html",
    "format:check": "prettier --check src server scripts tests vite.config.js package.json railway.json index.html"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.17.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "vite": "^7.2.0"
  }
}
